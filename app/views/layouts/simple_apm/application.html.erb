<!DOCTYPE html>
<html lang="<%= simple_apm_locale %>">
<head>
  <title><%= t("simple_apm.#{action_name}.title", default: 'Simple APM') %> · Simple APM</title>
  <meta charset="utf-8">
  <meta content="IE=Edge,chrome=1" http-equiv="X-UA-Compatible">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">
  <link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/3.3.7/css/bootstrap.min.css" integrity="sha384-BVYiiSIFeK1dGmJRAkycuHAHRg32OmUcww7on3RYdg4Va+PmSTsz/K68vbdEjh4u" crossorigin="anonymous">
  <link rel="stylesheet" href="//cdn.datatables.net/1.10.15/css/jquery.dataTables.min.css">
  <%= stylesheet_link_tag "simple_apm/application", media: "all" %>
  <script src="//cdnjs.cloudflare.com/ajax/libs/jquery/1.12.4/jquery.min.js"></script>
  <script src="//cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/3.3.7/js/bootstrap.min.js" integrity="sha384-Tc5IQib027qvyjSMfHjOMaLkfuWVxZxUPnCJA7l2mCWNIpG9mGCD8wGNIcPD7Txa" crossorigin="anonymous"></script>
  <script src="//cdnjs.cloudflare.com/ajax/libs/echarts/4.1.0/echarts.js"></script>
  <script src="//cdn.datatables.net/1.10.15/js/jquery.dataTables.min.js"></script>
  <script type="application/json" id="apm-ui-config"><%= json_escape({
    table: table_language,
    copied: t('simple_apm.diagnostics.copied'),
    copy_failed: t('simple_apm.diagnostics.copy_failed'),
    load_error: t('simple_apm.index.load_error')
  }.to_json).html_safe %></script>
  <%= javascript_include_tag "simple_apm/application" %>

  <%= csrf_meta_tags %>
</head>
<body class="simple-apm">
<a class="apm-skip-link" href="#main-content"><%= t('simple_apm.common.skip_content') %></a>
<div id="page-container" class="apm-shell">
  <nav class="apm-topbar">
    <div class="apm-topbar-inner">
      <div class="apm-brand">
        <span class="apm-brand-mark">SA</span>
        <span class="apm-brand-name">Simple APM</span>
      </div>
      <div class="apm-nav">
        <%
          [
            [dashboard_path(apm_date: apm_date), t("simple_apm.layout.nav_dashboard"), %w[dashboard]],
            [index_path(apm_date: apm_date), t("simple_apm.layout.nav_slow_requests"), %w[index show]],
            [actions_path(apm_date: apm_date), t("simple_apm.layout.nav_actions"), %w[actions action_info]],
            [data_path(apm_date: apm_date), t("simple_apm.layout.nav_data"), %w[data]]
          ].each do |m|
        %>
          <a class="navbar-brand <%= 'active' if m[2].include?(action_name) %>"
             href="<%= m[0] %>" <%= 'aria-current=page' if m[2].include?(action_name) %>>
            <%= m[1] %>
          </a>
        <% end %>
      </div>
      <div class="apm-language-switch" aria-label="<%= t("simple_apm.layout.language") %>">
        <% SimpleApm::ApplicationController::AVAILABLE_LOCALES.each do |locale| %>
          <%= link_to t("simple_apm.locales.#{locale}"),
                      set_locale_path(locale: locale),
                      class: ("active" if simple_apm_locale == locale) %>
        <% end %>
      </div>
      <div class="select-apm-date apm-date-select">
        <% date_path = action_name == 'show' ? (@request ? action_info_path : index_path) : request.path %>
        <%= form_tag date_path, method: :get, class: 'apm-date-form' do %>
          <label for="apm_date"><%= t("simple_apm.layout.date") %></label>
          <%= hidden_field_tag :action_name, @request.action_name if action_name == 'show' && @request %>
          <%= hidden_field_tag :action_name, @action.name if action_name == 'action_info' && @action %>
          <%= hidden_field_tag :count, @sample_limit if action_name == 'index' %>
          <%= select_tag 'apm_date', options_for_select((SimpleApm::Redis.in_apm_days + [apm_date]).uniq.sort.reverse, apm_date), class: 'form-control' %>
          <noscript><button type="submit" class="btn btn-primary"><%= t('simple_apm.common.apply') %></button></noscript>
        <% end %>
      </div>
    </div>
  </nav>
  <main id="main-content" class="apm-content" tabindex="-1">
    <% if flash[:notice].present? %>
      <div class="apm-notice" role="status"><%= flash[:notice] %></div>
    <% end %>
    <%= yield %>
  </main>
</div>
<footer class="apm-footer">
  <div class="apm-footer-status">
    <% if SimpleApm::Redis.running? %>
      <span class="apm-status apm-status-ok"><%= t("simple_apm.layout.collected") %></span>
    <% else %>
      <span class="apm-status apm-status-danger"><%= t("simple_apm.common.paused") %></span>
    <% end %>
  </div>
  <div class="apm-footer-meta">
    <% SimpleApm::Redis.simple_info.each do |k, v| %>
      <%
        redis_label_key =
          case k
          when '系统内存'
            'system_memory'
          when '当前内存占用'
            'current_memory'
          when '当前内存占用(rss)'
            'current_memory_rss'
          when '占用内存峰值'
            'peak_memory'
          when 'redis版本'
            'redis_version'
          when /db[0-9]+/
            'db'
          end
        redis_label = redis_label_key ? t("simple_apm.layout.redis_info.#{redis_label_key}") : k
      %>
      <span><label><%= redis_label %>：</label><%= v %></span>
    <% end %>
  </div>
</footer>
<div id="sql-modal" class="modal" aria-hidden="true" aria-labelledby="sql-modal-title" role="dialog" style="display: none;" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-popout">
    <div class="apm-modal-panel">
      <div class="apm-modal-header">
        <h2 id="sql-modal-title" class="apm-modal-title">SQL</h2>
        <div class="apm-toolbar-actions">
          <button type="button" class="btn btn-primary" data-copy-target="sql-modal-text"><%= t('simple_apm.common.copy') %></button>
          <button type="button" class="btn apm-button-secondary" data-dismiss="modal"><%= t('simple_apm.common.close') %></button>
        </div>
      </div>
      <div class="apm-modal-body">
        <pre id="sql-modal-text" class="modal-content" data-lang="SQL"></pre>
        <p class="apm-copy-status" role="status" aria-live="polite"></p>
      </div>
    </div>

  </div>
</div>

</body>
</html>
