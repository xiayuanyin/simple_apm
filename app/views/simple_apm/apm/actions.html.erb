<div class="apm-page-header">
  <div>
    <h1 class="apm-page-title"><%= t("simple_apm.actions.title") %></h1>
    <p class="apm-page-subtitle"><%= t("simple_apm.actions.subtitle") %></p>
  </div>
</div>

<% total_hits = @actions.sum { |action| action.click_count.to_i } %>
<div class="apm-metrics apm-metrics-compact">
  <div class="apm-stat">
    <p class="apm-stat-label"><%= t("simple_apm.actions.action_count") %></p>
    <div class="apm-stat-value"><%= number_with_delimiter(@actions.length) %></div>
    <div class="apm-stat-meta"><%= apm_date %></div>
  </div>
  <div class="apm-stat">
    <p class="apm-stat-label"><%= t("simple_apm.actions.total_hits") %></p>
    <div class="apm-stat-value"><%= number_with_delimiter(total_hits) %></div>
    <div class="apm-stat-meta"><%= t("simple_apm.dashboard.current_day_total") %></div>
  </div>
  <div class="apm-stat">
    <p class="apm-stat-label"><%= t("simple_apm.actions.weighted_avg_response") %></p>
    <div class="apm-stat-value"><%= total_hits.positive? ? sec_str(@actions.sum { |action| action.time.to_f } / total_hits) : '—' %></div>
    <div class="apm-stat-meta"><%= t("simple_apm.actions.summary_hint") %></div>
  </div>
</div>

<section class="apm-panel">
  <div class="apm-panel-header">
    <div>
      <h2 class="apm-panel-title"><%= t("simple_apm.actions.list_title") %></h2>
      <p class="apm-panel-subtitle"><%= t("simple_apm.actions.list_subtitle") %></p>
    </div>
  </div>
  <div class="apm-panel-body">
    <div class="apm-table-wrap">
      <table id="actions-table" class="table">
        <thead>
        <tr>
          <th scope="col"><%= t("simple_apm.actions.name") %></th>
          <th scope="col"><%= t("simple_apm.actions.click_count") %></th>
          <th scope="col"><%= t("simple_apm.actions.avg_response_time") %></th>
          <th scope="col"><%= t("simple_apm.actions.avg_db_time") %></th>
          <th scope="col"><%= t("simple_apm.actions.avg_sql_count") %></th>
          <th scope="col"><%= t("simple_apm.actions.avg_http_time") %></th>
          <th scope="col"><%= t("simple_apm.actions.fastest_response_time") %></th>
          <th scope="col"><%= t("simple_apm.actions.slowest_response_time") %></th>
        </tr>
        </thead>
        <tbody>
        <% @actions.each do |action| %>
          <% has_hits = action.click_count.to_i.positive? %>
          <tr>
            <td class="apm-mono"><%= link_to action.name, action_info_path(action_name: action.name, apm_date: apm_date) %></td>
            <td data-order="<%= action.click_count.to_i %>"><%= number_with_delimiter(action.click_count.to_i) %></td>
            <td data-order="<%= has_hits ? action.avg_time : 0 %>"><%= has_hits ? sec_str(action.avg_time) : '—' %></td>
            <td data-order="<%= has_hits ? action.avg_db_time : 0 %>"><%= has_hits ? sec_str(action.avg_db_time) : '—' %></td>
            <td data-order="<%= has_hits ? action.avg_queries_count : 0 %>"><%= has_hits ? action.avg_queries_count.round(1) : '—' %></td>
            <td data-order="<%= has_hits ? action.avg_http_time : 0 %>"><%= has_hits ? sec_str(action.avg_http_time) : '—' %></td>
            <td data-order="<%= action.fast_time.to_f %>"><%= action.fast_id.present? ? link_to(sec_str(action.fast_time), show_path(id: action.fast_id, apm_date: apm_date)) : '—' %></td>
            <td data-order="<%= action.slow_time.to_f %>"><%= action.slow_id.present? ? link_to(sec_str(action.slow_time), show_path(id: action.slow_id, apm_date: apm_date)) : '—' %></td>
          </tr>
        <% end %>
        </tbody>
      </table>
    </div>
  </div>
</section>
<script type="text/javascript">
  $(document).ready(function(){
      $('#actions-table').DataTable(window.SimpleApmUI.tableOptions({
          order: [[2, 'desc']],
          columnDefs: [{type: 'num', targets: [1, 2, 3, 4, 5, 6, 7]}]
      }))

  })
</script>
