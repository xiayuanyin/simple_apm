<div class="apm-page-header">
  <div>
    <h1 class="apm-page-title"><%= t("simple_apm.data.title") %></h1>
    <p class="apm-page-subtitle"><%= t("simple_apm.data.subtitle") %></p>
  </div>
</div>

<% total_hits = @data.sum { |day| day[:hits].to_i } %>
<div class="apm-metrics apm-metrics-compact">
  <div class="apm-stat">
    <p class="apm-stat-label"><%= t("simple_apm.data.retained_days") %></p>
    <div class="apm-stat-value"><%= number_with_delimiter(@data.length) %></div>
    <div class="apm-stat-meta"><%= t("simple_apm.data.history_title") %></div>
  </div>
  <div class="apm-stat">
    <p class="apm-stat-label"><%= t("simple_apm.data.retained_requests") %></p>
    <div class="apm-stat-value"><%= number_with_delimiter(total_hits) %></div>
    <div class="apm-stat-meta"><%= t("simple_apm.data.summary_hint") %></div>
  </div>
  <div class="apm-stat">
    <p class="apm-stat-label"><%= t("simple_apm.data.weighted_avg_response") %></p>
    <div class="apm-stat-value"><%= total_hits.positive? ? sec_str(@data.sum { |day| day[:time].to_f } / total_hits) : '—' %></div>
    <div class="apm-stat-meta"><%= t("simple_apm.dashboard.weighted_daily_average") %></div>
  </div>
</div>

<section class="apm-panel">
  <div class="apm-panel-header">
    <div>
      <h2 class="apm-panel-title"><%= t("simple_apm.data.collection_status") %></h2>
      <p class="apm-panel-subtitle"><%= t("simple_apm.data.collection_subtitle") %></p>
    </div>
    <div class="apm-toolbar-actions">
      <% if SimpleApm::Redis.running? %>
        <span class="apm-status apm-status-ok"><%= t("simple_apm.common.running") %></span>
        <%= button_to t("simple_apm.data.pause_collection"), data_delete_path(type: 'stop_data'), method: :post, class: 'btn btn-warning', form: {data: {confirm: t("simple_apm.data.confirm_pause")}} %>
      <% else %>
        <span class="apm-status apm-status-danger"><%= t("simple_apm.common.paused") %></span>
        <%= button_to t("simple_apm.data.resume_collection"), data_delete_path(type: 'rerun_data'), method: :post, class: 'btn btn-primary' %>
      <% end %>
    </div>
  </div>
  <div class="apm-panel-body">
    <div class="apm-toolbar">
      <div>
        <strong><%= t("simple_apm.data.delete_data") %></strong>
        <p class="apm-page-subtitle"><%= t("simple_apm.data.delete_subtitle") %></p>
      </div>
      <div class="apm-toolbar-actions">
        <%= button_to t("simple_apm.data.keep_one_week"), data_delete_path(type: 'week'), method: :post, class: 'btn btn-danger', form: {data: {confirm: t("simple_apm.data.confirm_delete_week")}} %>
        <%= button_to t("simple_apm.data.keep_one_month"), data_delete_path(type: 'month'), method: :post, class: 'btn btn-danger', form: {data: {confirm: t("simple_apm.data.confirm_delete_month")}} %>
      </div>
    </div>
  </div>
</section>

<section class="apm-panel">
  <div class="apm-panel-header">
    <div>
      <h2 class="apm-panel-title"><%= t("simple_apm.data.history_title") %></h2>
      <p class="apm-panel-subtitle"><%= t("simple_apm.data.history_subtitle") %></p>
    </div>
  </div>
  <div class="apm-panel-body">
    <% if @data.empty? %>
      <div class="apm-empty-state">
        <h3 class="apm-panel-title"><%= t("simple_apm.data.no_data") %></h3>
        <p><%= t("simple_apm.data.no_data_hint") %></p>
      </div>
    <% else %>
    <div class="apm-table-wrap">
      <table id="history-table" class="table">
        <thead>
        <tr>
          <th scope="col"><%= t("simple_apm.data.date") %></th>
          <th scope="col"><%= t("simple_apm.data.request_count") %></th>
          <th scope="col"><%= t("simple_apm.data.avg_response_time") %></th>
          <th scope="col"><%= t("simple_apm.data.operation") %></th>
        </tr>
        </thead>
        <tbody>
        <% @data.sort_by { |day| day[:day] }.reverse.each do |d| %>
          <tr>
            <td class="apm-mono"><%= link_to d[:day], dashboard_path(apm_date: d[:day]) %></td>
            <td data-order="<%= d[:hits].to_i %>"><%= number_with_delimiter(d[:hits].to_i) %></td>
            <td data-order="<%= d[:avg_time].to_f %>"><%= d[:hits].to_i.positive? ? sec_str(d[:avg_time]) : '—' %></td>
            <td>
              <div class="apm-toolbar-actions">
                <%= link_to t("simple_apm.data.view_actions"), actions_path(apm_date: d[:day]), class: 'btn apm-button-secondary' %>
                <%= link_to t("simple_apm.data.view_slow_requests"), index_path(apm_date: d[:day]), class: 'btn apm-button-secondary' %>
                <%= button_to t("simple_apm.data.delete"), data_delete_path(date: d[:day]), method: :post, class: 'btn btn-danger', form: {data: {confirm: t("simple_apm.data.confirm_delete")}} %>
              </div>
            </td>
          </tr>
        <% end %>
        </tbody>
      </table>
    </div>
    <% end %>
  </div>
</section>
<% unless @data.empty? %>
<script>
  $(document).ready(function () {
    $('#history-table').DataTable(window.SimpleApmUI.tableOptions({
      order: [[0, 'desc']],
      columnDefs: [
        {type: 'num', targets: [1, 2]},
        {orderable: false, searchable: false, targets: [3]}
      ]
    }));
  });
</script>
<% end %>
