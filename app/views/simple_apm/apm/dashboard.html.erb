<div class="apm-page-header">
  <div>
    <h1 class="apm-page-title"><%= t("simple_apm.dashboard.title") %></h1>
    <p class="apm-page-subtitle"><%= t("simple_apm.dashboard.subtitle") %></p>
  </div>
  <div class="apm-toolbar-actions">
    <%= link_to t("simple_apm.layout.nav_actions"), actions_path(apm_date: apm_date), class: 'btn apm-button-secondary' %>
    <%= link_to t("simple_apm.layout.nav_slow_requests"), index_path(apm_date: apm_date), class: 'btn btn-primary' %>
  </div>
</div>

<div class="apm-metrics">
  <div class="apm-stat">
    <p class="apm-stat-label"><%= t("simple_apm.dashboard.daily_avg_response") %></p>
    <div class="apm-stat-value"><%= @daily_stats[:hits].positive? ? sec_str(@daily_stats[:avg_time]) : '—' %></div>
    <div class="apm-stat-meta"><%= t("simple_apm.dashboard.weighted_daily_average") %></div>
  </div>
  <div class="apm-stat">
    <p class="apm-stat-label"><%= t("simple_apm.dashboard.hits") %></p>
    <div class="apm-stat-value"><%= number_with_delimiter(@daily_stats[:hits]) %></div>
    <div class="apm-stat-meta"><%= t("simple_apm.dashboard.current_day_total") %></div>
  </div>
  <div class="apm-stat">
    <p class="apm-stat-label"><%= t("simple_apm.dashboard.peak_avg_response") %></p>
    <div class="apm-stat-value"><%= @daily_stats[:hits].positive? ? sec_str(@time_arr.map(&:to_f).max.to_f) : '—' %></div>
    <div class="apm-stat-meta"><%= t("simple_apm.dashboard.interval_peak") %></div>
  </div>
  <div class="apm-stat">
    <p class="apm-stat-label"><%= t("simple_apm.dashboard.current_collection") %></p>
    <div class="apm-stat-value">
      <% if SimpleApm::Redis.running? %>
        <span class="apm-status apm-status-ok"><%= t("simple_apm.common.running") %></span>
      <% else %>
        <span class="apm-status apm-status-danger"><%= t("simple_apm.common.paused") %></span>
      <% end %>
    </div>
    <div class="apm-stat-meta"><%= t("simple_apm.dashboard.redis_status") %></div>
  </div>
  <div class="apm-stat">
    <p class="apm-stat-label"><%= t("simple_apm.dashboard.query_date") %></p>
    <div class="apm-stat-value"><%= apm_date %></div>
    <div class="apm-stat-meta"><%= t("simple_apm.dashboard.switch_in_top_right") %></div>
  </div>
</div>

<% if @daily_stats[:hits].zero? %>
  <section class="apm-panel">
    <div class="apm-empty-state">
      <h2 class="apm-panel-title"><%= t("simple_apm.dashboard.no_data") %></h2>
      <p><%= t("simple_apm.dashboard.no_data_hint") %></p>
      <%= link_to t("simple_apm.layout.nav_data"), data_path, class: 'btn apm-button-secondary' %>
    </div>
  </section>
<% else %>
<div class="apm-grid">
  <section class="apm-panel apm-col-6">
    <div class="apm-panel-header">
      <div>
        <h2 class="apm-panel-title"><%= t("simple_apm.dashboard.response_time") %></h2>
        <p class="apm-panel-subtitle"><%= t("simple_apm.dashboard.response_time_subtitle") %></p>
      </div>
    </div>
    <div class="apm-panel-body">
      <div id="time_chart" class="apm-chart" role="img" aria-label="<%= t("simple_apm.dashboard.response_time") %> · <%= apm_date %>"></div>
    </div>
  </section>

  <section class="apm-panel apm-col-6">
    <div class="apm-panel-header">
      <div>
        <h2 class="apm-panel-title"><%= t("simple_apm.dashboard.hit_count") %></h2>
        <p class="apm-panel-subtitle"><%= t("simple_apm.dashboard.hit_count_subtitle") %></p>
      </div>
    </div>
    <div class="apm-panel-body">
      <div id="hits_chart" class="apm-chart" role="img" aria-label="<%= t("simple_apm.dashboard.hit_count") %> · <%= apm_date %>"></div>
    </div>
  </section>
</div>

<script>
  (function () {
    var time_chart = echarts.init(document.getElementById('time_chart')),
      hits_chart = echarts.init(document.getElementById('hits_chart'));
  time_chart.setOption({
    animation: false,
    color: ['#0f766e'],
    grid: {left: 16, right: 18, top: 32, bottom: 16, containLabel: true},
    tooltip: {trigger: 'axis'},
    xAxis: {
      data: <%= @x_names.to_json.html_safe %>,
      axisLine: {lineStyle: {color: '#c8d2df'}},
      axisLabel: {color: '#667085'}
    },
    yAxis: {
      type: 'value',
      name: 's',
      axisLine: {show: false},
      splitLine: {lineStyle: {color: '#eef2f7'}},
      axisLabel: {color: '#667085'}
    },
    series: [{
        name: '<%= j t("simple_apm.dashboard.response_time") %> (s)',
        type: 'line',
        showSymbol: true,
        symbolSize: 4,
        areaStyle: {color: 'rgba(15, 118, 110, 0.10)'},
        data: <%= @time_arr.each_with_index.map { |time, i| @hits_arr[i].to_i.positive? ? time : nil }.to_json.html_safe %>
      }]
  })

  hits_chart.setOption({
    animation: false,
    color: ['#2563eb'],
    grid: {left: 16, right: 18, top: 32, bottom: 16, containLabel: true},
    tooltip: {trigger: 'axis'},
    xAxis: {
      data: <%= @x_names.to_json.html_safe %>,
      axisLine: {lineStyle: {color: '#c8d2df'}},
      axisLabel: {color: '#667085'}
    },
    yAxis: {
      type: 'value',
      minInterval: 1,
      axisLine: {show: false},
      splitLine: {lineStyle: {color: '#eef2f7'}},
      axisLabel: {color: '#667085'}
    },
    series: [{
      name: '<%= j t("simple_apm.dashboard.hit_count") %>',
      type: 'bar',
      data: <%= @hits_arr.to_json.html_safe %>
    }]
  })

  $(window).on('resize.simpleApmCharts', function () {
    time_chart.resize()
    hits_chart.resize()
  })
  })();
</script>
<% end %>
